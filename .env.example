# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── MongoDB ──────────────────────────────────────────────────
# For local dev (no Docker):
MONGO_URI=mongodb+srv://rssaini7976:XIyUowYO2ZBA1aTt@school-management.ji2sk.mongodb.net/ichat

# For Docker Compose (mongo service):
# MONGO_URI=mongodb://ichat_user:strongpassword@mongo:27017/ichat?authSource=admin
MONGO_USERNAME=ichat_user
MONGO_PASSWORD=change_me_strong_password

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_at_least_64_char_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_64_char_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP / SMS (Twilio) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Cloudinary (Media Storage) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=ichat
CLOUDINARY_API_KEY=389742233558995
CLOUDINARY_API_SECRET=mBG1rtOKti3jv_PfqkvO03hKq6U

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4200,https://your-domain.com

# ── Deployment ────────────────────────────────────────────────
# Base API URL used by the Ionic mobile app
API_BASE_URL=https://your-domain.com/api
