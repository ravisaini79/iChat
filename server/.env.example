# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/ichat

# Security & JWT Secrets
JWT_SECRET=ichat_super_secret_access_key_2026_key_change_me
JWT_REFRESH_SECRET=ichat_super_secret_refresh_key_2026_key_change_me
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# OTP Provider Configuration
OTP_PROVIDER=mock
OTP_API_KEY=mock_api_key

# Firebase Cloud Messaging
FCM_PROJECT_ID=mock_fcm_project
FCM_CLIENT_EMAIL=mock_fcm@example.com
FCM_PRIVATE_KEY=mock_private_key
